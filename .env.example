NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27018/dynamic_pricing?replicaSet=rs0&directConnection=true

JWT_SECRET=
JWT_TTL_SECONDS=900
JWT_ISSUER=dynamic-pricing-api
JWT_AUDIENCE=dynamic-pricing-clients

CORS_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_COUPON_MAX=10
RESERVATION_TTL_SECONDS=900
AUDIT_QUOTE_TTL_SECONDS=900
BCRYPT_ROUNDS=12
TRUST_PROXY=false

# Cloud name of your Cloudinary account (a public identifier, not a secret). Empty rejects every imageUrl.
CLOUDINARY_CLOUD_NAME=

SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
