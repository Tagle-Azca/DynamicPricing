NODE_ENV=development
PORT=3000
MONGODB_URI=mongodb://localhost:27017/dynamic_pricing?replicaSet=rs0&directConnection=true

# Required, at least 32 characters. Generate one with: openssl rand -hex 32
JWT_SECRET=
JWT_TTL_SECONDS=900
JWT_ISSUER=dynamic-pricing-api
JWT_AUDIENCE=dynamic-pricing-clients

# Comma-separated absolute origins, e.g. http://localhost:5173. Empty means no cross-origin access.
CORS_ORIGINS=

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
RATE_LIMIT_AUTH_MAX=10
RATE_LIMIT_COUPON_MAX=10
BCRYPT_ROUNDS=12
# Set to true only behind a trusted reverse proxy
TRUST_PROXY=false

# Optional, used only by "npm run seed" to create an admin user
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
